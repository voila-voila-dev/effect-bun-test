{
  "name": "@voila.dev/effect-bun-test",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "description": "Effect v4 testing helpers for Bun's native bun:test runner — the @effect/vitest API on Bun",
  "homepage": "https://github.com/voila-voila-dev/effect-bun-test",
  "repository": {
    "type": "git",
    "url": "https://github.com/voila-voila-dev/effect-bun-test.git"
  },
  "bugs": {
    "url": "https://github.com/voila-voila-dev/effect-bun-test/issues"
  },
  "keywords": [
    "effect",
    "bun",
    "bun:test",
    "testing",
    "test-runner"
  ],
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "ci": "bun run check && bun run build && bun test"
  },
  "peerDependencies": {
    "effect": "^4.0.3",
    "@types/bun": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "effect": "4.0.3",
    "typescript": "7.0.2"
  }
}
